# Supabase Configuration
# คัดลอกค่าจริงจาก Supabase Project Settings -> API แล้วนำไปใส่ใน Vercel Environment Variables หรือ .env.local

# Supabase URL (เช่น https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Supabase Anon Key (Public Key สำหรับ client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Secret Key สำหรับ server-side bypass RLS — ห้ามเปิดเผยเด็ดขาด)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# POS Terminal Security PINs (รหัส PIN สำหรับเครื่องหน้าร้าน iPad / Terminal)
POS_OWNER_PIN=8888
POS_STAFF_PIN=1234

